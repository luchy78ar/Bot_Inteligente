# ============================================
# VARIABLES DE ENTORNO - CONFIGURACIÓN
# ============================================

# ----- EXCHANGE -----
# Exchange: binance, bybit, bingx, pionex
EXCHANGE=binance

# Par de trading (use el formato del exchange)
SYMBOL=BTC/USDT:USDT

# Usar testnet (true/false)
TESTNET=false

# ----- API KEYS -----
# Obtén tus API keys desde el panel del exchange
API_KEY=tu_api_key_aqui
API_SECRET=tu_api_secret_aqui

# API Keys Testnet (obtén desde testnet.binancefuture.com)
TESTNET_API_KEY=
TESTNET_API_SECRET=

# ----- TRADING -----
# Apalancamiento (1-125)
LEVERAGE=20

# Porcentaje del balance para la primera orden (0.01 = 1%)
INITIAL_VOLUME_PCT=0.01

# Multiplicador de volumen para cada DCA
VOLUME_MULTIPLIER=1.5

# Número máximo de niveles DCA
MAX_DCA_LEVELS=20

# Porcentaje de caída para ejecutar DCA (0.01 = 1%)
DCA_STEP_PCT=0.01

# Take Profit (0.015 = 1.5%)
TAKE_PROFIT_PCT=0.015

# Stop Loss global (0.15 = 15%)
STOP_LOSS_PCT=0.15

# Intervalo de verificación DCA en segundos
DCA_INTERVAL_SEC=30

# ----- ANÁLISIS DE TENDENCIA -----
# Timeframe para análisis (15m, 1h, 4h)
TREND_TIMEFRAME=15m

# Indicador: EMA o RSI
TREND_INDICATOR=EMA

# ----- TELEGRAM -----
# Token del bot de Telegram (obtén de @BotFather)
TELEGRAM_BOT_TOKEN=

# Tu ID de Telegram (obtén de @userinfobot)
TELEGRAM_ADMIN_ID=

# ----- MODO SALVAVIDAS -----
# Porcentaje antes de liquidación para transferir margen
LIQUIDATION_THRESHOLD_PCT=0.20

# Transferir margen automáticamente (true/false)
AUTO_TRANSFER_MARGIN=true

# ----- MODO REINVERSIÓN -----
# Activar modo compuesto (true/false)
REINVEST_MODE=true

# Máximo de ciclos (0 = infinito)
MAX_CYCLES=0

# ----- WEB SERVER -----
# Puerto para health check
WEB_PORT=8080

# Host (0.0.0.0 para producción)
WEB_HOST=0.0.0.0

# ----- LOGGING -----
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
